# tuned/repo.env -- flash-attention-specific settings for tuned builds. Sourced by tuned/env.sh after the shared
# device and toolkit definitions (tuned/common-data, vendored from zbrad/tuned-common). Tracked, so a release is
# reproducible.
#
# This file only ADDS repo-specific settings. Changing a shared key (GPU_TUNED_VARIANT/PLATFORM/CUDA_ARCH/
# HW_LABEL, CUDA_*, TOOLKIT_*) is a loud error from gpu_tuned_load_repo_env. Plain assignment on purpose:
# this file is sourced inside a function, where `declare` would make the variable local and lose it.

# Upstream ref the build-info stamp and the DRAFT notes compare against (the merge-base of HEAD with it).
GPU_TUNED_UPSTREAM_REF="${GPU_TUNED_UPSTREAM_REF:-upstream/main}"

# GPU_TUNED_FA_ARCH is this repo's own arch code (setup.py FLASH_ATTN_CUDA_ARCHS, semicolon-separated, no dot),
# which is not always the device's real arch (GPU_TUNED_CUDA_ARCH, shared):
case "${GPU_TUNED_VARIANT}" in
    gb10)
        # "121a": true architecture-specific sm_121 SASS, not the family-generic "121f" that upstream PR #2257
        # defaults to (setup.py add_cuda_gencodes(), a zbrad/flash-attention-only addition; ../SM121_SUPPORT.md).
        GPU_TUNED_FA_ARCH="121a"
        ;;
    rtx40)
        # Ada (sm_89) is NOT natively targeted: add_cuda_gencodes() recognizes only 80/90/100/110/120/121, so Ada runs
        # the sm_80 SASS path (Ampere-compatible for the ops this kernel set uses). "80" is the closest true equivalent
        # upstream offers; revisit if Dao-AILab adds an 89 bucket. The binary is therefore sm_80, not the device's sm_89.
        GPU_TUNED_FA_ARCH="80"
        ;;
    rtx50)
        # "120" maps to compute_120f/sm_120 on CUDA >= 12.9 (family-specific SASS), native in upstream Dao-AILab.
        GPU_TUNED_FA_ARCH="120"
        ;;
esac
